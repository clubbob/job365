# Firebase Client — job365 전용 프로젝트를 새로 생성한 뒤 값을 채웁니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
# 운영(Vercel): joblink365.com
# 로컬: 프로젝트의 firebaseapp.com
# 구글 로그인 창의 「(으)로 이동」 문구는 이 값입니다. Firebase 허용 도메인과
# Google OAuth 리디렉션 URI(https://joblink365.com/__/auth/handler)에도 같은 도메인을 넣습니다.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (서버 전용 — 서비스 계정 JSON에서 발급)
# 운영(Vercel Production)에도 같은 값을 넣어야 관리자 회원·채용·이력서·문의 목록이 보입니다.
# FIREBASE_PRIVATE_KEY는 한 줄로 넣고, 줄바꿈은 \n 으로 적습니다. 앞뒤 큰따옴표는 빼 주세요.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# 줄바꿈이 깨지면 private_key 전체를 Base64로 넣어 아래를 씁니다.
# FIREBASE_PRIVATE_KEY_BASE64=

# App
# 로컬: http://localhost:3000
# 운영(Vercel): https://joblink365.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (서버 전용)
ADMIN_USERNAME=joblink365
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 국세청 사업자등록 상태조회 (data.go.kr, 서버 전용)
# 로컬은 개발계정, 운영 배포는 공공데이터포털 운영계정 키를 사용하세요.
NTS_BUSINESS_SERVICE_KEY=

# Google AdSense (발급 전엔 슬롯만 표시)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Email (비밀번호 찾기 · 가입/지원 알림 — Naver SMTP)
# DISABLE_EMAIL_SERVICE=true
# NAVER_SMTP_HOST=smtp.naver.com
# NAVER_SMTP_PORT=587
# NAVER_SMTP_SECURE=false
# NAVER_SMTP_USER=
# NAVER_SMTP_PASS=
# NAVER_SMTP_FROM="JobLink 365 <noreply@example.com>"
# ADMIN_NOTIFY_EMAIL=
# INQUIRY_NOTIFY_EMAIL=
