# Firebase Client — job365 전용 프로젝트를 새로 생성한 뒤 값을 채웁니다.
NEXT_PUBLIC_FIREBASE_API_KEY=
# 운영(Vercel) 커스텀 도메인: joblink365.com (Firebase Auth 허용 도메인에도 추가)
# 로컬: localhost / job365-dev.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin (서버 전용 — 서비스 계정 JSON에서 발급)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# App
# 로컬: http://localhost:3000
# 운영(Vercel): https://joblink365.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin (서버 전용)
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# 국세청 사업자등록 상태조회 (data.go.kr, 서버 전용)
# 로컬은 개발계정, 운영 배포는 공공데이터포털 운영계정 키를 사용하세요.
NTS_BUSINESS_SERVICE_KEY=

# Google AdSense (발급 전엔 슬롯만 표시)
NEXT_PUBLIC_ADSENSE_CLIENT=

# Email (비밀번호 찾기 · 가입/지원 알림 — Naver SMTP)
# DISABLE_EMAIL_SERVICE=true
# NAVER_SMTP_HOST=smtp.naver.com
# NAVER_SMTP_PORT=587
# NAVER_SMTP_SECURE=false
# NAVER_SMTP_USER=
# NAVER_SMTP_PASS=
# NAVER_SMTP_FROM="JOB 365 <noreply@example.com>"
# ADMIN_NOTIFY_EMAIL=
# INQUIRY_NOTIFY_EMAIL=
